{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/caffe/build/tools/caffe-d",
            "args": [
                "train",
                "--solver",
                "${workspaceFolder}/models/person_detection_action_recognition_2_classes/solver.prototxt",
                "--weights",
                "${workspaceFolder}/init_weights/action_detection_0005.caffemodel"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/models/person_detection_action_recognition_2_classes",
            "environment": [
                {
                    "name": "PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION",
                    "value": "python"
                },
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/caffe/python:${env:PYTHONPATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }

    ]
}